{
  "name": "waku-books",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "waku dev",
    "build": "waku build",
    "start": "waku start",
    "typegen": "waku router typegen",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed-authors && pnpm db:seed-books",
    "db:seed-authors": "tsx src/lib/db/seed-authors.ts",
    "db:seed-books": "tsx src/lib/db/seed-books.ts",
    "db:seed-thumbhash": "tsx src/lib/db/seed-thumbhash.ts",
    "preview:cloudflare": "CLOUDFLARE=1 waku build && npx --yes wrangler@4.131.2 dev",
    "deploy:cloudflare": "CLOUDFLARE=1 waku build && npx --yes wrangler@4.131.2 deploy"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.38",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.14",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.0.0",
    "react-server-dom-webpack": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "thumbhash": "^0.1.1",
    "unlazy": "^2.0.1",
    "waku": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "packageManager": "pnpm@11.24.0"
}
