{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waku-books",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
